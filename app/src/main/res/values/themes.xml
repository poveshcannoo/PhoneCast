<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <style name="ReceiverTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Big, high-contrast, focus-visible buttons (works with a TV remote D-pad). -->
    <style name="Btn">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Section">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Dim">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
